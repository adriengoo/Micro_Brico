# Required opt-in. Without this variable, CAMP-001.TC-001.foundation is SKIPPED
# and no integration/UI test may be started.
MB_TEST_DB_ENABLED=1
MB_TEST_DB_DRIVER=QMYSQL
MB_TEST_DB_HOST=localhost
MB_TEST_DB_PORT=3306
# Must be a dedicated schema. The value dbtest is refused by the guard.
MB_TEST_DB_NAME=db4qtest
MB_TEST_DB_USER=replace_with_test_user
# May be empty, but the variable must exist.
MB_TEST_DB_PASSWORD=replace_with_test_password
# Required by the TC-001 fixture. Keep the actual value out of version control.
MB_TEST_ADMIN_PASSWORD=replace_with_fixture_admin_password
