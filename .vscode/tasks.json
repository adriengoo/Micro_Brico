{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure Release",
      "type": "process",
      "command": "${config:cmake.cmakePath}",
      "args": ["--preset", "qt-6.11.2-mingw-release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: Build Release",
      "type": "process",
      "command": "${config:cmake.cmakePath}",
      "args": ["--build", "--preset", "qt-6.11.2-mingw-release", "--parallel"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: Configure Release",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
